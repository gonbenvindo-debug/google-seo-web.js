# Required for direct Google API routes. The refresh token needs the matching API scopes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Google Ads API only. The developer token must be approved for the account.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v24

# Optional short-lived override for local testing; do not commit access tokens.
GOOGLE_ACCESS_TOKEN=
